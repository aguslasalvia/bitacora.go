---
import flaskConical from 'lucide-static/icons/flask-conical.svg?raw';
import calendarDays from 'lucide-static/icons/calendar-days.svg?raw';
import save from 'lucide-static/icons/save.svg?raw';
import search from 'lucide-static/icons/search.svg?raw';
import eye from 'lucide-static/icons/eye.svg?raw';
import x from 'lucide-static/icons/x.svg?raw';
import packageCheck from 'lucide-static/icons/package-check.svg?raw';
import packagePlus from 'lucide-static/icons/package-plus.svg?raw';
import inbox from 'lucide-static/icons/inbox.svg?raw';
import list from 'lucide-static/icons/list.svg?raw';
import filter from 'lucide-static/icons/filter.svg?raw';
import clipboardList from 'lucide-static/icons/clipboard-list.svg?raw';
import clipboardPlus from 'lucide-static/icons/clipboard-plus.svg?raw';
import squarePlus from 'lucide-static/icons/square-plus.svg?raw';

const icons = {
  'flask-conical': flaskConical,
  'calendar-days': calendarDays,
  save,
  search,
  eye,
  x,
  'package-check': packageCheck,
  'package-plus': packagePlus,
  inbox,
  list,
  filter,
  'clipboard-list': clipboardList,
  'clipboard-plus': clipboardPlus,
  'square-plus': squarePlus,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
const svg = icons[name].replace('<svg ', `<svg class="${className ?? ''}" `);
---

<Fragment set:html={svg} />
